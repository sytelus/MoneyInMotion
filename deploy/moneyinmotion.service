[Unit]
Description=MoneyInMotion personal finance website
After=network.target

[Service]
Type=simple
User=moneyinmotion
Group=moneyinmotion
WorkingDirectory=/opt/moneyinmotion
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env node packages/server/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
