{
  "name": "moneyinmotion",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w packages/server\" \"npm run dev -w packages/web\"",
    "dev:server": "npm run dev -w packages/server",
    "dev:web": "npm run dev -w packages/web",
    "build": "npm run build -w packages/core && npm run build -w packages/server && npm run build -w packages/web",
    "build:core": "npm run build -w packages/core",
    "build:server": "npm run build -w packages/server",
    "build:web": "npm run build -w packages/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:legacy": "node scripts/verify-legacy-data.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" eslint.config.js",
    "typecheck": "tsc -b",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.19.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.12.0",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
